{
  "name": "seseragi-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/check-release.mjs && node scripts/render-library.mjs --check && node scripts/check-content.mjs && node --test scripts/code-highlight.test.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/check-release.mjs && node scripts/render-library.mjs --check && node scripts/check-content.mjs && node --test scripts/code-highlight.test.mjs && astro check",
    "check:content": "node scripts/check-release.mjs && node scripts/render-library.mjs --check && node scripts/check-content.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "sync:library": "node scripts/sync-library.mjs",
    "render:library": "node scripts/render-library.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:release": "node --test scripts/docs-version.test.mjs && node scripts/check-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:highlight": "node --test scripts/code-highlight.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.5",
    "fumadocs-core": "16.17.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.58.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24.14.0"
  }
}
