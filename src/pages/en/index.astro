---
import Layout from "@/components/layout.astro";
import { Home } from "@/components/docs";
import { Code } from "astro:components";
import grammar from "@/lib/seseragi.tmLanguage.json";
import snippet from "../../../examples/parcel.ssrg?raw";
---
<Layout lang="en" title="From data to ideas in code." description="Learn Seseragi with working examples. Explore values, functions, types, and effects through code and diagrams.">
  <Home pathname={Astro.url.pathname} client:load>
    <div id="main-content" tabindex="-1" class="landing">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> THE SESERAGI LANGUAGE</p>
          <h1>From data.<br />To ideas<span> in code.</span></h1>
          <p class="hero-description">Shape your data. Connect it with functions.<br />Learn Seseragi, one small program at a time.</p>
          <div class="hero-actions"><a class="primary-link" href="/en/docs/learn/first-program">Write your first program <span aria-hidden="true">↗</span></a><a class="subtle-link" href="/en/docs">What is Seseragi? <span aria-hidden="true">→</span></a></div>
          <p class="hero-note">Experimental <span>·</span> Try it in your browser</p>
        </div>
        <div class="hero-example">
          <div class="code-window"><div class="code-title"><span class="code-dots" aria-hidden="true">● ● ●</span><span>parcel.ssrg</span><span class="code-language">Seseragi</span></div><Code code={snippet.trim()} lang={{ ...grammar, name: "seseragi" }} theme="github-dark" /><div class="code-output"><span>OUTPUT</span><samp>Sent to Kyoto</samp></div></div>
          <p class="example-caption">Model states with a type. Turn them into text with match.</p>
        </div>
      </section>
      <section class="routes-section" aria-labelledby="routes-title">
        <div class="section-intro"><p class="eyebrow">A PLACE TO START</p><h2 id="routes-title">Start with what you need.</h2><p>Learn the language. Build an app. Look up a rule.</p></div>
        <div class="route-grid">
          <a class="route-card" href="/en/docs/learn"><span class="route-number">01 / LEARN</span><h3>Learn by writing.<span aria-hidden="true">↗</span></h3><p>Move from values and functions to types, effects, and state with working examples.</p><span class="route-label">Follow the learning path</span></a>
          <a class="route-card" href="/en/docs/guides"><span class="route-number">02 / GUIDES</span><h3>Build something useful.<span aria-hidden="true">↗</span></h3><p>Create CLI and Web apps, handle forms, test behavior, and connect TypeScript.</p><span class="route-label">Choose a task</span></a>
          <a class="route-card" href="/en/docs/reference"><span class="route-number">03 / REFERENCE</span><h3>Find the exact rule.<span aria-hidden="true">↗</span></h3><p>Look up language rules, tooling, and standard library types by topic or purpose.</p><span class="route-label">Open the reference</span></a>
        </div>
      </section>
      <section class="idea-section"><p class="eyebrow">THINK IN SESERAGI</p><h2>Model a state. Transform it for display.</h2><p>A sent parcel carries its destination city.<br />Describe the difference with a type, then handle each case with match.</p><div class="idea-flow" role="img" aria-label="Sent with destination Kyoto goes into label, then the resulting text is printed"><div><span>DATA</span><strong>Sent</strong><small>State and destination</small></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>FUNCTION</span><strong>label</strong><small>Create display text</small></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>EFFECT</span><strong>println</strong><small>Print the result</small></div></div><a class="subtle-link" href="/en/docs/learn/algebraic-data-types">Learn to model states <span aria-hidden="true">→</span></a></section>
      <footer class="site-footer"><span>Seseragi <span class="footer-muted">/ Official documentation</span></span><a href="https://github.com/KentaroMorishita/seseragi">Language on GitHub ↗</a></footer>
    </div>
  </Home>
</Layout>
