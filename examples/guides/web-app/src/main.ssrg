import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal } from "std/signal"

alias View = html.Html<Task<Unit>>

fn view count: MutableSignal<Int>
  -> current: Int -> View =
  html.main {
    style: html.style {
      margin: "32px auto",
      maxWidth: "32rem",
      padding: "24px"
    },
    children: [
      html.h1 { children: "Counter" },
      html.p {
        children: `Count: ${current}`
      },
      html.button {
        buttonType: "button",
        onClick:
          signals.update (\n: Int -> n + 1) count,
        children: "Add one"
      },
      html.button {
        buttonType: "button",
        onClick: signals.set 0 count,
        children: "Reset"
      }
    ]
  }

fn perform action: Task<Unit>
  -> Task<Unit> = action

pub effect fn main = do {
  count <- signals.make 0
  target <-
    dom.query "#app"
    |> mapError (\error: dom.DomError -> show error)
  let options = dom.defaultOptions ()
  (
    dom.run options target perform $
      signals.map (view count) count
  )
  |> mapError (\error: dom.DomRuntimeError<Never> -> show error)
}
