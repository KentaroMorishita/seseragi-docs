import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal }
  from "std/signal"

alias Counter = MutableSignal<Int>
alias View = html.Html<Task<Unit>>

fn view title: String
  -> state: Counter
  -> current: Int -> View =
  html.section {
    children: [
      html.h2 { children: title },
      html.p {
        children: show current
      },
      html.button {
        buttonType: "button",
        children: "Add one",
        onClick: signals.update
          (\n: Int -> n + 1) state
      }
    ]
  }

pub effect fn create title: String
  -> Signal<View> = do {
  state <- signals.make 0
  state
  |> signals.map (view title state)
  |> succeed
}
