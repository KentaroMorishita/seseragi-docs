import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal } from "std/signal"

alias View = html.Html<Task<Unit>>

fn greeting name: String -> String =
  if name == "" then
    "Enter your name"
  else
    `Hello, ${name}`

fn edited draft: MutableSignal<String>
  -> message: MutableSignal<String>
  -> event: html.InputEvent
  -> Task<Unit> =
  signals.transaction [
    signals.planSet event.value draft,
    signals.planSet "" message
  ]

fn submitted draft: MutableSignal<String>
  -> message: MutableSignal<String>
  -> Task<Unit> = do {
  name <- signals.read draft
  signals.set (greeting name) message
}

fn view draft: MutableSignal<String>
  -> message: MutableSignal<String>
  -> current: String
  -> result: String -> View =
  html.main {
    style: html.style {
      margin: "32px auto",
      maxWidth: "32rem",
      padding: "24px"
    },
    children: [
      html.h1 {
        children: "Greeting"
      },
      html.form {
        onSubmit: submitted draft message,
        children: [
          html.label {
            htmlFor: "name",
            children: "Your name"
          },
          html.input {
            id: "name",
            name: "name",
            value: current,
            onInput: edited draft message
          },
          html.button {
            buttonType: "submit",
            children: "Greet"
          }
        ]
      },
      html.p {
        role: "status",
        children: result
      }
    ]
  }

fn perform action: Task<Unit>
  -> Task<Unit> = action

pub effect fn main = do {
  draft <- signals.make ""
  message <- signals.make ""
  target <-
    dom.query "#app"
    |> mapError (\error: dom.DomError -> show error)
  let options = dom.defaultOptions ()
  (
    dom.run options target perform $
      signals.combine (view draft message) draft message
  )
  |> mapError (\error: dom.DomRuntimeError<Never> -> show error)
}
