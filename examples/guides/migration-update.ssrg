// docs:start update
type Action =
  | Increment
  | Reset

fn update action: Action
  -> count: Int -> Int =
  match action {
    Increment -> count + 1
    Reset -> 0
  }
// docs:end update

pub effect fn main = do {
  // docs:start cases
  update Increment 0
  |> show
  |> println
  update Reset 9
  |> show
  |> println
  // docs:end cases
}
