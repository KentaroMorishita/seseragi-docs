// docs:start update
import * as signals from "std/signal"

fn increment count: Int -> Int =
  count + 1
// docs:end update

pub effect fn main = do {
  // docs:start cases
  count <- signals.make 0
  signals.update increment count
  increased <- signals.read count
  increased
  |> show
  |> println
  signals.set 0 count
  reset <- signals.read count
  reset
  |> show
  |> println
  // docs:end cases
}
