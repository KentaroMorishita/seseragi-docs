// docs:start declaration
fn same<A> left: A -> right: A
  -> Bool where Eq<A> =
  left == right
// docs:end declaration

pub effect fn main = do {
  // docs:start numbers
  println (show (same 42 42))
  // docs:end numbers
  // docs:start strings
  println (show (same "Aki" "Aki"))
  // docs:end strings
  // docs:start arrays
  println (show (same [1, 2] [2, 1]))
  // docs:end arrays
}
