// docs:start data
struct Account {
  name: String,
}
// docs:end data

// docs:start declaration
type Session =
  | Guest
  | SignedIn Account
// docs:end declaration

pub effect fn main = {
  // docs:start value
  let session: Session =
    SignedIn (Account { name: "Aki" })
  // docs:end value
  println ""
}
