import * as effects from "std/effect"

// docs:start failure-type
type InputError =
  | Invalid String
// docs:end failure-type

// docs:start source
effect fn load -> String
fails String =
  effects.fail "empty"
// docs:end source

// docs:start mapping
effect fn checked -> String
fails InputError =
  load ()
  |> effects.mapError Invalid
// docs:end mapping

// docs:start recovery
effect fn describe error: InputError
  -> String =
  match error {
    Invalid reason -> {
      let message =
        `invalid: ${reason}`
      effects.succeed message
    }
  }
// docs:end recovery

pub effect fn main = do {
  // docs:start use
  value <-
    checked ()
    |> effects.recover describe
  println value
  // docs:end use
}
