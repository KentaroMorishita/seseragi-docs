// docs:start trait
trait Render<A> {
  fn render value: A -> String
}
// docs:end trait

// docs:start badge
struct Badge {
  label: String,
}

instance Render<Badge> {
  fn render value: Badge -> String =
    value.label
}
// docs:end badge

// docs:start framed
fn framed<A> value: A -> String
where Render<A> =
  `<${render value}>`
// docs:end framed

// docs:start tag
struct Tag {
  text: String,
}

instance Render<Tag> {
  fn render value: Tag -> String =
    `#${value.text}`
}
// docs:end tag

pub effect fn main = do {
  // docs:start badge-use
  Badge { label: "ADMIN" }
  |> framed
  |> println
  // docs:end badge-use
  // docs:start tag-use
  Tag { text: "help" }
  |> framed
  |> println
  // docs:end tag-use
}
