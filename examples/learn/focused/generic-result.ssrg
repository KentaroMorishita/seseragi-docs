// docs:start data
type Result<A> =
  | Failed String
  | Succeeded A
// docs:end data

// docs:start declaration
fn valueOr<A> fallback: A
  -> result: Result<A> -> A =
  match result {
    Failed _ -> fallback
    Succeeded value -> value
  }
// docs:end declaration

pub effect fn main = {
  // docs:start inputs
  let number =
    Succeeded 42
    |> valueOr 0
  let text =
    Failed "unavailable"
    |> valueOr "untitled"
  // docs:end inputs
  println `${number}/${text}`
}
