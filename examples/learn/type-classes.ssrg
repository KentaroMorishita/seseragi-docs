trait Render<A> {
  fn render value: A -> String
}

struct Badge {
  label: String,
}

instance Render<Badge> {
  fn render value: Badge -> String =
    value.label
}

fn framed<A> value: A -> String
where Render<A> =
  `<${render value}>`

pub effect fn main =
  Badge { label: "ADMIN" }
  |> framed
  |> println
